{
  "name": "redmaitong",
  "version": "1.0.0",
  "description": "红脉通 · 红色数字资源开放共享平台（桌面版，Electron + SQLite）",
  "main": "electron/main.js",
  "author": "红脉通课程设计组",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node backend/server.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.redmaitong.app",
    "productName": "红脉通",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "backend/**/*",
      "electron/**/*",
      "database/sqlite_init.sql"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}.exe"
    }
  }
}
