# ============================================================
# 红脉通后端环境变量模板
# 用法：复制本文件为 .env，然后填上你的真实值
#   cp .env.example .env
# ============================================================

# 数据库连接 —— MySQL 就装在 VM 本机，127.0.0.1 不用改
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=redmaitong

# 后端监听端口（浏览器访问 http://VM_IP:3000）
PORT=3000

# JWT 签名密钥 —— 生产环境务必改成一段随机长字符串
JWT_SECRET=redmaitong-dev-secret-change-me
